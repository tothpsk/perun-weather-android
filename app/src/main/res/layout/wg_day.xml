<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wg_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/wg_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/wg_place" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/><ImageView android:id="@+id/wg_gps" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="4dp" android:src="@drawable/ic_wg_gps" android:visibility="gone" android:contentDescription="@null"/><ImageView android:id="@+id/wg_alert" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="6dp" android:visibility="gone" android:contentDescription="@null"/></LinearLayout></FrameLayout><ImageView android:id="@+id/wg_day_prev" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="4dp" android:padding="2dp" android:contentDescription="@string/wg_day_prev"/><TextView android:id="@+id/wg_day_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFE8EAF0" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="@string/wg_loading"/><ImageView android:id="@+id/wg_day_next" android:layout_width="28dp" android:layout_height="28dp" android:padding="2dp" android:contentDescription="@string/wg_day_next"/><ImageView android:id="@+id/wg_refresh" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="2dp" android:padding="4dp" android:src="@drawable/ic_wg_refresh" android:contentDescription="@string/wg_refresh"/></LinearLayout>
