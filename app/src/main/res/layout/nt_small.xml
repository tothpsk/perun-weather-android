<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingHorizontal="10dp" android:paddingVertical="5dp">
    <ImageView android:id="@+id/nt_icon" android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/nt_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/nt_system_text" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/nt_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/nt_system_text" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/nt_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/nt_system_text" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp"/>
</LinearLayout>
