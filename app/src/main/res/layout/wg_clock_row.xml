<?xml version="1.0" encoding="utf-8"?>
<!-- Compact with clock, one row: the clock, the place (or the place over the chosen value), the weather and the refresh button where it fits.
     The empty frames share the free room: all of them for even gaps, only the one after the clock with the long date. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wg_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/wg_bg">
<FrameLayout android:id="@+id/wg_sp0" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<include layout="@layout/wg_clock_block"/>
<FrameLayout android:id="@+id/wg_sp1" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<ImageView android:id="@+id/wg_place" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:contentDescription="@null"/>
<FrameLayout android:id="@+id/wg_sp2" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<ImageView android:id="@+id/wg_weather" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@null"/>
<FrameLayout android:id="@+id/wg_sp3" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<ImageView android:id="@+id/wg_refresh" android:layout_width="26dp" android:layout_height="26dp" android:padding="4dp" android:src="@drawable/ic_wg_refresh" android:visibility="gone" android:contentDescription="@string/wg_refresh"/>
</LinearLayout>
