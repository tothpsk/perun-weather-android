<?xml version="1.0" encoding="utf-8"?>
<!-- 6 days and 6 hours with clock: the clock and the current weather, six columns (reaching 12 dp into the left padding for the icon of the bottom row), the time of the update and the refresh button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wg_root" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="2dp" android:background="@drawable/wg_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<include layout="@layout/wg_clock_block"/>
<FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<ImageView android:id="@+id/wg_weather" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@null"/>
</LinearLayout>
<ImageView android:id="@+id/wg_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:layout_marginStart="-12dp" android:layout_marginEnd="6dp" android:scaleType="fitCenter" android:contentDescription="@null"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/wg_foot" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#FFBBC4D2" android:textSize="10sp"/>
<ImageView android:id="@+id/wg_refresh" android:layout_width="22dp" android:layout_height="22dp" android:padding="3dp" android:src="@drawable/ic_wg_refresh" android:contentDescription="@string/wg_refresh"/>
</LinearLayout>
</LinearLayout>
