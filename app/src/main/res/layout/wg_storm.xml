<?xml version="1.0" encoding="utf-8"?>
<!-- Precipitation and storms: one picture; the refresh button is placed by margins where the picture keeps its room. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wg_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:background="@drawable/wg_bg">
<ImageView android:id="@+id/wg_storm_img" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@null"/>
<ImageView android:id="@+id/wg_refresh" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|start" android:padding="3dp" android:src="@drawable/ic_wg_refresh" android:visibility="gone" android:contentDescription="@string/wg_refresh"/>
</FrameLayout>
