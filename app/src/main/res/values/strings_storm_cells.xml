    <string name="storm_cell_heavy" formatted="false">"Oranžová bunka"</string>
    <string name="storm_cell_heavy_note" formatted="false">"40 až 49 dBZ, silné zrážky"</string>
    <string name="storm_cell_intense" formatted="false">"Červená bunka"</string>
