+    val layers:List<GlyphLayer> by lazy { make() }
+}
+
+internal const val GlyphLine=1.75f
+
+/** Draws a glyph over the whole draw area. dp: the size of the area in dp (for pictures drawn at density 1). */
+internal fun DrawScope.drawGlyph(g:Glyph,color:Color,muted:Color=color,turn:Float=0f,dp:Float=size.width/density) {
+    val k=size.width/24f
+    val line=max(GlyphLine,1.3f*24f/dp.coerceAtLeast(1f))*g.line
+    scale(k,k,Offset.Zero) {
+        for(l in g.layers) {
+            val c=if(l.muted) muted else color
+            if(l.turns && turn!=0f) rotate(turn,Offset(12f,12f)) { paint(l,c,line) } else paint(l,c,line)
+        }
+    }
+}
+private fun DrawScope.paint(l:GlyphLayer,c:Color,line:Float) {
+    if(l.fill) drawPath(l.path,c) else drawPath(l.path,c,style=Stroke(line*l.weight,cap=StrokeCap.Round,join=StrokeJoin.Round))
+}
+
+@Composable internal fun GlyphIcon(g:Glyph,color:Color,dimension:Dp,muted:Color=color,turn:Float=0f,modifier:Modifier=Modifier) {
+    Canvas(modifier.size(dimension)) { drawGlyph(g,color,muted,turn) }
+}
+
+/** The glyph as a picture of px pixels for the widgets and the notifications; dp is the size it is shown at. */
+internal fun glyphPicture(g:Glyph,color:Int,px:Int,dp:Float=18f,muted:Int=color,turn:Float=0f):Bitmap {
+    val n=px.coerceAtLeast(1)
+    val image=ImageBitmap(n,n)
+    CanvasDrawScope().draw(Density(1f),LayoutDirection.Ltr,androidx.compose.ui.graphics.Canvas(image),Size(n.toFloat(),n.toFloat())) { drawGlyph(g,Color(color),Color(muted),turn,dp) }
+    return image.asAndroidBitmap()
+}
